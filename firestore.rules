rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
    // The Firebase Trigger Email extension owns this collection; the digest
    // function writes to it via the Admin SDK, which bypasses rules entirely.
    // No client should ever read or write it directly.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}